import java.util.*;

class Solution {
    public int maxStackHeight(int[] r, int[] h) {
        int n = r.length;

        int[][] discs = new int[n][2];
        for (int i = 0; i < n; i++) {
            discs[i][0] = r[i];
            discs[i][1] = h[i];
        }

        Arrays.sort(discs, (a, b) -> {
            if (a[0] != b[0]) return a[0] - b[0];
            return b[1] - a[1];
        });

        int maxH = 0;
        for (int height : h) {
            maxH = Math.max(maxH, height);
        }
        int[] bit = new int[maxH + 2];
        int ans = 0;

        for (int[] disc : discs) {
            int height = disc[1];

            int best = query(bit, height - 1);

            int newHeight = best + height;
            ans = Math.max(ans, newHeight);

            update(bit, height, newHeight);
        }
        return ans;
    }

    private void update(int[] bit, int idx, int val) {
        while (idx < bit.length) {
            bit[idx] = Math.max(bit[idx], val);
            idx += idx & (-idx);
        }
    }

    private int query(int[] bit, int idx) {
        int max = 0;
        while (idx > 0) {
            max = Math.max(max, bit[idx]);
            idx -= idx & (-idx);
        }
        return max;
    }
}
