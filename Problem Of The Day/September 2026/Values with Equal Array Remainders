class Solution {
    public int sameMod(int[] arr) {
        int n = arr.length;
        
        boolean allEqual = true;
        for (int i = 1; i < n; i++) {
            if (arr[i] != arr[0]) {
                allEqual = false;
                break;
            }
        }
        if (allEqual) return -1;
        
        int g = 0;
        for (int i = 1; i < n; i++) {
            g = gcd(g, Math.abs(arr[i] - arr[0]));
        }
        
        int count = 0;
        for (int d = 1; d * d <= g; d++) {
            if (g % d == 0) {
                count++;
                if (d != g / d) {
                    count++;
                }
            }
        }
        return count;
    }
    
    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
