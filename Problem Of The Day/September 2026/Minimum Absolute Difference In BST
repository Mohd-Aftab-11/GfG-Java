class Solution {
    private int minDiff;
    private Integer prev;

    public int absDiff(Node root) {
        minDiff = Integer.MAX_VALUE;
        prev = null;
        inOrder(root);
        return minDiff;
    }

    private void inOrder(Node node) {
        if (node == null) return;

        inOrder(node.left);

        if (prev != null) {
            minDiff = Math.min(minDiff, node.data - prev);
        }
        prev = node.data;

        inOrder(node.right);
    }
}
