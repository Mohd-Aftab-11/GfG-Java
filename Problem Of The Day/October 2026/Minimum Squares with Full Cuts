class Solution {
    public int minSquares(int n, int m) {
        if (n < m) {
            int temp = n;
            n = m;
            m = temp;
        }
        int count = 0;

        while (m > 0) {
            count += n / m;
            int rem = n % m;
            n = m;
            m = rem;
        }
        return count;
    }
}
