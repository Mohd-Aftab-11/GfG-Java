class Solution {
    public int minimumSum(String s) {
        int n = s.length();

        char[] half = new char[(n + 1) / 2];
        for (int i = 0; i < half.length; i++) {
            int j = n - 1 - i;
            char a = s.charAt(i);
            char b = s.charAt(j);
            if (a != '?' && b != '?' && a != b) {
                return -1;
            }
            if (a != '?') half[i] = a;
            else if (b != '?') half[i] = b;
            else half[i] = '?';
        }
        long halfSum = 0;
        int i = 0;
        int len = half.length;

        while (i < len) {
            if (half[i] != '?') {
                int j = i + 1;
                while (j < len && half[j] == '?') j++;
                if (j < len) {
                    halfSum += Math.abs(half[j] - half[i]);
                }
                i = j;
            } else {
                i++;
            }
        }
        return (int) (2 * halfSum);
    }
}
