class Solution {
    public ArrayList<Integer> lexicographicallyLargest(int[] arr) {
        int n = arr.length;
        int i = 0;

        while (i < n) {
            int j = i;
            int parity = arr[i] & 1;

            while (j < n && (arr[j] & 1) == parity) {
                j++;
            }

            Integer[] slice = new Integer[j - i];
            for (int k = i; k < j; k++) slice[k - i] = arr[k];
            java.util.Arrays.sort(slice, java.util.Collections.reverseOrder());
            for (int k = i; k < j; k++) arr[k] = slice[k - i];

            i = j;
        }

        ArrayList<Integer> result = new ArrayList<>();
        for (int v : arr) result.add(v);
        return result;
    }
}
