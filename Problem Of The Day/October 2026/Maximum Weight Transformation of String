class Solution {
    public int getMaxWeight(String s) {
        int n = s.length();
        if (n == 0) return 0;
        if (n == 1) return 1;

        int[] dp = new int[n + 1];
        dp[0] = 0;
        dp[1] = 1;

        for (int i = 2; i <= n; i++) {
            int opt1 = dp[i-1] + 1;
            int pairWeight = (s.charAt(i-2) != s.charAt(i-1)) ? 4 : 3;
            int opt2 = dp[i-2] + pairWeight;
            dp[i] = Math.max(opt1, opt2);
        }
        return dp[n];
    }
}
