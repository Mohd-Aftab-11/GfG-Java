class Solution {
    static final int MOD = 1_000_000_007;

    public int cntSubsets(int[] arr, int l, int r) {
        int n = arr.length;

        long[] freq = new long[r + 1];
        long bigCount = 0;

        for (int x : arr) {
            if (x <= r) freq[x]++;
            else bigCount++;
        }

        long[] pow2 = new long[n + 1];
        pow2[0] = 1;
        for (int i = 1; i <= n; i++) {
            pow2[i] = (pow2[i - 1] * 2) % MOD;
        }

        long[] prefix = new long[r + 2];
        prefix[0] = 1;
        for (int i = 0; i <= r; i++) {
            long ways = (pow2[(int) freq[i]] - 1 + MOD) % MOD;
            prefix[i + 1] = (prefix[i] * ways) % MOD;
        }

        long[] suffixGT = new long[r + 2];
        long running = bigCount;
        for (int k = r; k >= 0; k--) {
            suffixGT[k] = running;
            running += freq[k];
        }

        long answer = 0;
        for (int k = l; k <= r; k++) {
            long ways = (prefix[k] * pow2[(int) suffixGT[k]]) % MOD;
            answer = (answer + ways) % MOD;
        }
        return (int) answer;
    }
}
