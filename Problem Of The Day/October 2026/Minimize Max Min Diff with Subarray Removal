class Solution {
    public int minDiff(int k, int[] arr) {
        int n = arr.length;

        if (n - k == 0) return 0;

        int[] prefixMin = new int[n];
        int[] prefixMax = new int[n];
        int[] suffixMin = new int[n];
        int[] suffixMax = new int[n];

        prefixMin[0] = arr[0];
        prefixMax[0] = arr[0];
        for (int i = 1; i < n; i++) {
            prefixMin[i] = Math.min(prefixMin[i-1], arr[i]);
            prefixMax[i] = Math.max(prefixMax[i-1], arr[i]);
        }

        suffixMin[n-1] = arr[n-1];
        suffixMax[n-1] = arr[n-1];
        for (int i = n-2; i >= 0; i--) {
            suffixMin[i] = Math.min(suffixMin[i+1], arr[i]);
            suffixMax[i] = Math.max(suffixMax[i+1], arr[i]);
        }
        int minDiff = Integer.MAX_VALUE;

        for (int i = 0; i <= n - k; i++) {
            int currentMin, currentMax;

            if (i == 0) {
                currentMin = suffixMin[k];
                currentMax = suffixMax[k];
            } else if (i + k == n) {
                currentMin = prefixMin[i - 1];
                currentMax = prefixMax[i - 1];
            } else {
                currentMin = Math.min(prefixMin[i - 1], suffixMin[i + k]);
                currentMax = Math.max(prefixMax[i - 1], suffixMax[i + k]);
            }
            minDiff = Math.min(minDiff, currentMax - currentMin);
        }
        return minDiff;
    }
}
