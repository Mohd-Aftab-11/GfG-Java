class Solution {
    public int minComputation(int[] files) {
        int n = files.length;
        if (n <= 1) return 0;

        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for (int f : files) {
            pq.offer(f);
        }
        int totalCost = 0;

        while (pq.size() > 1) {
            int first = pq.poll();
            int second = pq.poll();
            int merged = first + second;
            totalCost += merged;
            pq.offer(merged);
        }

        return totalCost;
    }
}
