class Solution {
    static final int MOD = 1_000_000_007;

    public int countBT(int h) {
        if (h == 0) return 1;
        if (h == 1) return 1;

        long prev2 = 1;
        long prev1 = 1;

        for (int i = 2; i <= h; i++) {
            long a = (prev1 * prev1) % MOD;
            long b = (2L * prev1 % MOD) * prev2 % MOD;
            long cur = (a + b) % MOD;

            prev2 = prev1;
            prev1 = cur;
        }
        return (int) prev1;
    }
}
