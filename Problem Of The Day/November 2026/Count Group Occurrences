import java.util.*;

class Solution {
    int getCount(String s, int k) {
        Map<Character, Integer> groupCount = new HashMap<>();

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            int count = 1;

            while (i + 1 < s.length() && s.charAt(i + 1) == c) {
                count++;
                i++;
            }
            groupCount.put(c, groupCount.getOrDefault(c, 0) + 1);
        }
        int result = 0;
        for (int count : groupCount.values()) {
            if (count == k) {
                result++;
            }
        }
        return result;
    }
}
