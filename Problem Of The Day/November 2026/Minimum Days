class Solution {
    public int getMinimumDays(String s, int[] p) {
        int n = s.length();

        if (isValid(s, p, 0)) return 0;

        int lo = 1, hi = n, ans = n;
        while (lo <= hi) {
            int mid = (lo + hi) >>> 1;
            if (isValid(s, p, mid)) {
                ans = mid;
                hi = mid - 1;
            } else {
                lo = mid + 1;
            }
        }
        return ans;
    }

    private boolean isValid(String s, int[] p, int days) {
        int n = s.length();
        char[] arr = s.toCharArray();

        for (int i = 0; i < days; i++) {
            arr[p[i]] = '?';
        }

        for (int i = 0; i + 1 < n; i++) {
            if (arr[i] != '?' && arr[i + 1] != '?' && arr[i] == arr[i + 1]) {
                return false;
            }
        }
        return true;
    }
}
