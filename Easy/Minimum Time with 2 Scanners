class Solution {
    public int minTime(int n, int s1, int s2) {
        int lo = 0, hi = n;
        while (lo < hi) {
            int mid = lo + (hi - lo) / 2;
            if ((long) mid * s1 >= (long) (n - mid) * s2) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }

        long ans = Long.MAX_VALUE;
        for (int k = Math.max(0, lo - 1); k <= Math.min(n, lo); k++) {
            long time = Math.max((long) k * s1, (long) (n - k) * s2);
            ans = Math.min(ans, time);
        }
        return (int) ans;
    }
}
