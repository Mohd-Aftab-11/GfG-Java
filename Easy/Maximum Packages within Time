class Solution {
    public int maxPackages(int[] arr, int totalTime) {
        int n = arr.length;

        int windowSize = Math.min(totalTime, n);

        long currentSum = 0;
        for (int i = 0; i < windowSize; i++) {
            currentSum += arr[i];
        }

        long maxSum = currentSum;

        for (int i = windowSize; i < n; i++) {
            currentSum += arr[i] - arr[i - windowSize];
            if (currentSum > maxSum) {
                maxSum = currentSum;
            }
        }
        return (int) maxSum;
    }
}
