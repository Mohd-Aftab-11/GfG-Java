import java.util.*;

class Solution {
    public int getCount(Node root, int k) {
        List<Integer> leafLevels = new ArrayList<>();
        collectLeaves(root, 1, leafLevels);

        Collections.sort(leafLevels);

        int count = 0;
        for (int level : leafLevels) {
            if (k >= level) {
                k -= level;
                count++;
            } else {
                break;
            }
        }

        return count;
    }

    private void collectLeaves(Node node, int level, List<Integer> leafLevels) {
        if (node == null) return;

        if (node.left == null && node.right == null) {
            leafLevels.add(level);
            return;
        }

        collectLeaves(node.left, level + 1, leafLevels);
        collectLeaves(node.right, level + 1, leafLevels);
    }
}
