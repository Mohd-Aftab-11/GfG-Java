import java.util.*;

class Solution {
    public ArrayList<String> generateUsernames(String[] arr) {
        Set<String> reserved = new HashSet<>(Arrays.asList(arr));
        Set<String> assigned = new HashSet<>();
        Map<String, Integer> nextK = new HashMap<>();
        ArrayList<String> result = new ArrayList<>();

        for (String s : arr) {
            if (!assigned.contains(s)) {
                result.add(s);
                assigned.add(s);
            } else {
                int k = nextK.getOrDefault(s, 1);
                while (true) {
                    String candidate = s + k;
                    if (!reserved.contains(candidate) && !assigned.contains(candidate)) {
                        result.add(candidate);
                        assigned.add(candidate);
                        nextK.put(s, k + 1);
                        break;
                    }
                    k++;
                }
            }
        }
        return result;
    }
}
