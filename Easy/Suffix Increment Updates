import java.util.ArrayList;

class Solution {
    static ArrayList<Integer> update(int n, int[] updates) {
        ArrayList<Integer> arr = new ArrayList<>();

        for (int i = 0; i < n; ++i)
            arr.add(0);

        for (int j : updates)
            arr.set(j, arr.get(j) + 1);

        int count = 0;

        for (int i = 0; i < n; ++i) {
            count += arr.get(i);
            arr.set(i, count);
        }
        return arr;
    }

    public static void main(String[] args) {
        
        int n = 3;
        int[] updates = { 0, 0, 1, 2 };

        ArrayList<Integer> result = update(n, updates);
        System.out.println(result);
    }
}
