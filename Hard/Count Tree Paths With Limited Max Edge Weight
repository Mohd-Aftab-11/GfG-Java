import java.util.*;

class Solution {
    public ArrayList<Integer> maximumWeight(int n, int[][] edges, int[] queries) {
        Arrays.sort(edges, (a, b) -> Integer.compare(a[2], b[2]));

        int q = queries.length;
        Integer[] qIdx = new Integer[q];
        for (int i = 0; i < q; i++) qIdx[i] = i;
        Arrays.sort(qIdx, (a, b) -> Integer.compare(queries[a], queries[b]));

        int[] parent = new int[n + 1];
        int[] size = new int[n + 1];
        for (int i = 1; i <= n; i++) {
            parent[i] = i;
            size[i] = 1;
        }

        long total = 0;
        int e = 0;

        ArrayList<Integer> result = new ArrayList<>(Collections.nCopies(q, 0));

        for (int qi = 0; qi < q; qi++) {
            int idx = qIdx[qi];
            int x = queries[idx];

            while (e < edges.length && edges[e][2] <= x) {
                int u = find(parent, edges[e][0]);
                int v = find(parent, edges[e][1]);
                if (u != v) {
                    long a = size[u], b = size[v];
                    total += a * b;
                    if (size[u] < size[v]) { int t = u; u = v; v = t; }
                    parent[v] = u;
                    size[u] += size[v];
                }
                e++;
            }
            result.set(idx, (int) total);
        }
        return result;
    }

    private int find(int[] parent, int x) {
        while (parent[x] != x) {
            parent[x] = parent[parent[x]];
            x = parent[x];
        }
        return x;
    }
}
