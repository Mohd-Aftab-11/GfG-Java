class Solution {
    public int largestSubsquare(char[][] mat) {
        int n = mat.length;

        int[][] right = new int[n][n + 1];
        int[][] down = new int[n + 1][n];

        for (int i = 0; i < n; i++) {
            for (int j = n - 1; j >= 0; j--) {
                if (mat[i][j] == 'X') {
                    right[i][j] = right[i][j + 1] + 1;
                }
            }
        }

        for (int j = 0; j < n; j++) {
            for (int i = n - 1; i >= 0; i--) {
                if (mat[i][j] == 'X') {
                    down[i][j] = down[i + 1][j] + 1;
                }
            }
        }
        int maxSize = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] != 'X') continue;

                int maxPossible = Math.min(right[i][j], down[i][j]);

                for (int k = maxPossible; k > maxSize; k--) {
                    if (right[i + k - 1][j] >= k && down[i][j + k - 1] >= k) {
                        maxSize = k;
                        break;
                    }
                }
            }
        }
        return maxSize;
    }
}
