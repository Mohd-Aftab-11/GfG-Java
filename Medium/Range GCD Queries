import java.util.*;

class Solution {
    private int[] tree;
    private int n;

    public ArrayList<Integer> processQueries(int[] arr, int[][] queries) {
        n = arr.length;
        tree = new int[4 * n];
        build(arr, 1, 0, n - 1);

        ArrayList<Integer> result = new ArrayList<>();

        for (int[] query : queries) {
            if (query[0] == 0) {
                int l = query[1];
                int r = query[2];
                result.add(queryGCD(1, 0, n - 1, l, r));
            } else {
                int index = query[1];
                int value = query[2];
                update(1, 0, n - 1, index, value);
            }
        }
        return result;
    }

    private void build(int[] arr, int node, int start, int end) {
        if (start == end) {
            tree[node] = arr[start];
            return;
        }
        int mid = (start + end) / 2;
        build(arr, 2 * node, start, mid);
        build(arr, 2 * node + 1, mid + 1, end);
        tree[node] = gcd(tree[2 * node], tree[2 * node + 1]);
    }

    private void update(int node, int start, int end, int idx, int value) {
        if (start == end) {
            tree[node] = value;
            return;
        }
        int mid = (start + end) / 2;
        if (idx <= mid) {
            update(2 * node, start, mid, idx, value);
        } else {
            update(2 * node + 1, mid + 1, end, idx, value);
        }
        tree[node] = gcd(tree[2 * node], tree[2 * node + 1]);
    }

    private int queryGCD(int node, int start, int end, int l, int r) {
        if (r < start || end < l) {
            return 0;
        }
        if (l <= start && end <= r) {
            return tree[node];
        }
        int mid = (start + end) / 2;
        int leftGCD = queryGCD(2 * node, start, mid, l, r);
        int rightGCD = queryGCD(2 * node + 1, mid + 1, end, l, r);
        return gcd(leftGCD, rightGCD);
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
