class Solution {
    public ArrayList<ArrayList<Integer>> socialNetwork(int[] arr) {
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        int n = arr.length + 1; // total users

        for (int i = 2; i <= n; i++) {
            ArrayList<int[]> reachable = new ArrayList<>();
            int current = i;
            int distance = 0;

            while (current != 1) {
                int friend = arr[current - 2];
                distance++;
                reachable.add(new int[]{friend, distance});
                current = friend;
            }
            Collections.reverse(reachable);

            for (int[] pair : reachable) {
                ArrayList<Integer> entry = new ArrayList<>();
                entry.add(i);
                entry.add(pair[0]);
                entry.add(pair[1]);
                result.add(entry);
            }
        }
        return result;
    }
}
