class Solution {
    public int maxFrequency(int[] arr, int k) {
        Arrays.sort(arr);
        int left = 0;
        int maxFreq = 1;
        long windowSum = 0;
        
        for (int right = 0; right < arr.length; right++) {
            windowSum += arr[right];
            
            while ((long)arr[right] * (right - left + 1) - windowSum > k) {
                windowSum -= arr[left];
                left++;
            }
            maxFreq = Math.max(maxFreq, right - left + 1);
        }
        return maxFreq;
    }
}
