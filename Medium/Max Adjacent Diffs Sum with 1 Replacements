class Solution {
    public int maxDiffSum(int[] arr) {
        int n = arr.length;
        if (n == 1) return 0;

        int dp0 = 0;
        int dp1 = 0;

        for (int i = 1; i < n; i++) {
            int prev0 = dp0;
            int prev1 = dp1;

            dp0 = Math.max(prev0 + Math.abs(arr[i-1] - arr[i]), prev1 + Math.abs(1 - arr[i]));

            dp1 = Math.max(prev0 + Math.abs(arr[i-1] - 1), prev1 + 0);
        }
        return Math.max(dp0, dp1);
    }
}
